{
  "name": "formpilot-ai",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs && node scripts/build-provider-repro.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" *.ts *.json *.html scripts/*.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" *.ts *.json *.html scripts/*.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.306",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.85.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
